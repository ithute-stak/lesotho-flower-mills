{
  email {$ACME_EMAIL}
}
{$LFM_CUSTOMER_DOMAIN} {
  encode zstd gzip
  reverse_proxy customer-web:3000
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
{$LFM_ADMIN_DOMAIN} {
  # Internal portals are deliberately closed until a verified identity-aware gateway is integrated.
  respond "Internal portal access is not activated" 403
  encode zstd gzip
  reverse_proxy admin-web:3001
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
  }
}
{$LFM_WAREHOUSE_DOMAIN} {
  # Private peer addresses alone do not prove the original user identity.
  respond "Internal portal access is not activated" 403
  encode zstd gzip
  reverse_proxy warehouse-web:3002
  header Strict-Transport-Security "max-age=31536000"
}
{$LFM_DRIVER_DOMAIN} {
  encode zstd gzip
  reverse_proxy driver-web:3003
  header Strict-Transport-Security "max-age=31536000"
}
